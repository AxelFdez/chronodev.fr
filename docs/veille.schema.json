{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronodev.fr/veille/derniere.schema.json",
  "title": "Dernière veille — fichier publié par n8n",
  "type": "object",
  "required": ["version", "entree"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "entree": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["date", "titre", "resume", "source", "validee"],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date de l'entrée de veille. Au-delà de 21 jours, le site masque le module."
            },
            "titre": { "type": "string", "minLength": 1, "maxLength": 120 },
            "resume": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Texte brut, en français. Le HTML éventuel est affiché tel quel, jamais interprété."
            },
            "source": {
              "type": "object",
              "required": ["nom", "url"],
              "additionalProperties": false,
              "properties": {
                "nom": { "type": "string", "minLength": 1, "maxLength": 80 },
                "url": { "type": "string", "pattern": "^https://" }
              }
            },
            "validee": {
              "type": "object",
              "required": ["par", "le"],
              "additionalProperties": false,
              "description": "Validation humaine dans n8n (PLAN.md C11). Sans elle, rien ne s'affiche.",
              "properties": {
                "par": { "type": "string", "minLength": 1, "maxLength": 60 },
                "le": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ]
    }
  }
}
